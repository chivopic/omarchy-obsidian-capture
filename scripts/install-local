#!/usr/bin/env python3
"""Safely link this checkout into Omarchy's local plugin directory."""

from __future__ import annotations

import argparse
import json
import os
import shutil
import sys
import tempfile
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]


def _read_manifest_id() -> str:
    with (ROOT / "manifest.json").open(encoding="utf-8") as manifest_file:
        plugin_id = json.load(manifest_file).get("id")
    if not isinstance(plugin_id, str) or not plugin_id or "/" in plugin_id:
        raise ValueError("manifest.json 中的插件 id 无效")
    return plugin_id


def _find_plugin_entry(config: dict) -> tuple[str, list, dict] | None:
    bar = config.get("bar")
    if not isinstance(bar, dict):
        return None
    layout = bar.get("layout")
    if not isinstance(layout, dict):
        return None
    for section, entries in layout.items():
        if isinstance(entries, list):
            for entry in entries:
                if isinstance(entry, dict) and entry.get("id") == _read_manifest_id():
                    return section, entries, entry
    return None


def install(plugin_dir: Path, shell_json: Path, apply: bool) -> list[str]:
    plugin_id = _read_manifest_id()
    plugin_dir = plugin_dir.expanduser()
    shell_json = shell_json.expanduser()
    link_path = plugin_dir / plugin_id
    actions: list[str] = []
    create_link = False
    link_created = False

    if link_path.is_symlink():
        if link_path.resolve() != ROOT:
            raise ValueError(f"插件路径已是指向其他位置的软链接，拒绝替换：{link_path}")
        actions.append(f"软链接已指向此仓库：{link_path}")
    elif link_path.exists():
        raise ValueError(f"插件路径已存在且不是指向此仓库的软链接，拒绝覆盖：{link_path}")
    else:
        actions.append(f"创建软链接：{link_path} -> {ROOT}")
        create_link = True

    def apply_link() -> None:
        nonlocal link_created
        if create_link and apply:
            plugin_dir.mkdir(parents=True, exist_ok=True)
            link_path.symlink_to(ROOT, target_is_directory=True)
            link_created = True

    if not shell_json.exists():
        actions.append("未找到 shell.json；未创建不完整配置。请在 Omarchy 设置中重新扫描并启用此插件。")
        apply_link()
        return actions
    if shell_json.is_symlink():
        raise ValueError(f"shell.json 是软链接，为避免替换链接目标而拒绝修改：{shell_json}")

    try:
        with shell_json.open(encoding="utf-8") as config_file:
            config = json.load(config_file)
    except (OSError, json.JSONDecodeError) as error:
        raise ValueError(f"无法读取有效的 shell.json：{error}") from error
    if not isinstance(config, dict):
        raise ValueError("shell.json 顶层必须是 JSON 对象")

    existing = _find_plugin_entry(config)
    if existing:
        actions.append(f"保留现有栏位配置（{existing[0]}），包括位置与设置")
        apply_link()
        return actions

    bar = config.get("bar")
    if not isinstance(bar, dict) or not isinstance(bar.get("layout"), dict):
        actions.append("shell.json 没有可识别的 bar.layout；保留配置不变，请用 Omarchy 设置启用插件。")
        apply_link()
        return actions
    layout = bar["layout"]
    section = "right"
    if section not in layout:
        actions.append("shell.json 没有 right 栏位；保留配置不变，请用 Omarchy 设置启用插件。")
        apply_link()
        return actions
    if not isinstance(layout[section], list):
        raise ValueError("shell.json 的 bar.layout.right 必须是数组")
    layout[section].append({"id": plugin_id})
    actions.append("将插件加入 shell.json 的右栏")
    if apply:
        backup = shell_json.with_name(f"{shell_json.name}.bak")
        temp_path: Path | None = None
        backup_created = False
        try:
            apply_link()
            suffix = 0
            while True:
                candidate = backup if suffix == 0 else shell_json.with_name(f"{shell_json.name}.bak.{suffix}")
                try:
                    descriptor = os.open(candidate, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
                except FileExistsError:
                    suffix += 1
                    continue
                os.close(descriptor)
                backup = candidate
                backup_created = True
                break
            shutil.copy2(shell_json, backup)
            with tempfile.NamedTemporaryFile(
                "w", encoding="utf-8", dir=shell_json.parent,
                prefix=f".{shell_json.name}.", suffix=".tmp", delete=False,
            ) as temp_file:
                temp_path = Path(temp_file.name)
                json.dump(config, temp_file, ensure_ascii=False, indent=2)
                temp_file.write("\n")
                temp_file.flush()
                os.fsync(temp_file.fileno())
            temp_path.chmod(shell_json.stat().st_mode & 0o777)
            os.replace(temp_path, shell_json)
        except BaseException:
            if backup_created:
                backup.unlink(missing_ok=True)
            if link_created:
                link_path.unlink(missing_ok=True)
            raise
        finally:
            if temp_path is not None:
                temp_path.unlink(missing_ok=True)
        actions.append(f"原配置备份到：{backup}")
    return actions


def main() -> int:
    config_home = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    parser = argparse.ArgumentParser(description="将当前仓库安全地链接为 Omarchy 本地插件")
    parser.add_argument("--plugins-dir", type=Path, default=config_home / "omarchy" / "plugins")
    parser.add_argument("--shell-json", type=Path, default=config_home / "omarchy" / "shell.json")
    parser.add_argument("--apply", action="store_true", help="实际创建软链接并更新已有 shell.json")
    args = parser.parse_args()
    try:
        actions = install(args.plugins_dir, args.shell_json, args.apply)
    except (OSError, ValueError) as error:
        print(f"install-local: {error}", file=sys.stderr)
        return 1
    for action in actions:
        print(action)
    if not args.apply:
        print("预览模式；确认目标后添加 --apply 执行。")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
